      "method": "GET",
      "path": "/api/v1/employee/check-duplicate",
      "auth": { "required": true, "roles": ["EMPLOYEE", "ADMIN"] },
      "rateLimiter": "apiLimiter",
      "description": "Check if a customer phone already has an open enquiry for this shop.",
      "queryParams": [
        { "name": "shopId", "type": "string", "required": true, "example": "shop-1111-uuid" },
        { "name": "phone", "type": "string", "required": true, "example": "9876543210" }
      ],
      "requestBody": null,
      "responses": {
        "200": {
          "success": true,
          "data": {
            "isDuplicate": true,
            "existingEnquiry": {
              "id": "enq-9999-uuid",
              "customer_name": "Ramesh Sharma",
              "customer_phone": "9876543210",
              "status": "PENDING",
              "assigned_to": "Amit Patel"
            }
          }
        }
      }
    },
    {
      "id": "employee-create-enquiry",
      "group": "Employee - Enquiries",
      "method": "POST",
      "path": "/api/v1/employee/enquiries",
      "auth": { "required": true, "roles": ["EMPLOYEE", "ADMIN"] },
      "rateLimiter": "apiLimiter",
      "description": "Creates customer enquiry. Tolerant to both legacy Flutter payload (estimatedBudget, tyreSize, tyreBrand) and modern payload (amount, tyreSizeId, tyreBrandId).",
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "fields": [
          { "name": "shopId", "type": "string", "required": true, "validation": "UUID of assigned active shop.", "example": "shop-1111-uuid" },
          { "name": "customerName", "type": "string", "required": true, "validation": "Non-empty string.", "example": "Rahul Varma" },
          { "name": "customerPhone", "type": "string", "required": true, "validation": "10-15 digits string.", "example": "9876543210" },
          { "name": "amount", "type": "number", "required": false, "validation": "Budget amount >= 0. Accepted as amount ?? estimatedBudget. 0 is allowed.", "example": 28000 },
          { "name": "estimatedBudget", "type": "number", "required": false, "validation": "Legacy field name for budget >= 0.", "example": 28000 },
          { "name": "tyreSizeId", "type": "string", "required": false, "validation": "UUID from tyre_sizes. Required if tyreSize text is omitted.", "example": "size-1111-uuid" },
          { "name": "tyreSize", "type": "string", "required": false, "validation": "Text specification (e.g. 215/60 R17). Best-effort matches tyre_size_id.", "example": "215/60 R17" },
          { "name": "tyreBrandId", "type": "string", "required": false, "validation": "UUID from tyre_brands. Required if tyreBrand text is omitted.", "example": "brand-1111-uuid" },
          { "name": "tyreBrand", "type": "string", "required": false, "validation": "Text brand name. Best-effort matches tyre_brand_id.", "example": "Bridgestone" },
          { "name": "vehicleType", "type": "string", "required": false, "validation": "Enum: TWO_WHEELER | FOUR_WHEELER | COMMERCIAL. Default: FOUR_WHEELER.", "example": "FOUR_WHEELER" },
          { "name": "vehicleModel", "type": "string", "required": false, "validation": "Car model name.", "example": "Creta SX" },
          { "name": "vehicleReg", "type": "string", "required": false, "validation": "License registration number.", "example": "KA-01-MJ-4521" },
          { "name": "carBrandId", "type": "string", "required": false, "validation": "UUID from car_brands.", "example": "carbrand-1111-uuid" },
          { "name": "carModelId", "type": "string", "required": false, "validation": "UUID from car_models.", "example": "carmodel-1111-uuid" },
          { "name": "fitStatus", "type": "string", "required": false, "validation": "Enum: FIT | UNFIT. Default: FIT.", "example": "FIT" },
          { "name": "unfitReason", "type": "string", "required": false, "validation": "Required if fitStatus is UNFIT.", "example": "Tyre size out of stock" },
          { "name": "quantity", "type": "integer", "required": false, "validation": "Positive integer >= 1. Default: 4.", "example": 4 },
          { "name": "followUpDate", "type": "string", "required": true, "validation": "ISO 8601 date string.", "example": "2026-10-05T10:00:00.000Z" },
          { "name": "remarks", "type": "string", "required": false, "validation": "Free-form follow-up note.", "example": "Customer prefers payment via UPI" }
        ]
      },
      "responses": {
        "201": {
          "success": true,
          "data": {
            "id": "enq-9999-uuid",
            "customer_name": "Rahul Varma",
            "customer_phone": "9876543210",
            "amount": 28000,
            "estimated_budget": 28000,
            "tyre_size": "215/60 R17",
            "tyre_brand": "Bridgestone",
            "tyre_size_id": "size-1111-uuid",
            "tyre_brand_id": "brand-1111-uuid",
            "status": "PENDING"
          }
        },
        "400": { "success": false, "message": "amount must be a valid positive number" },
        "403": { "success": false, "message": "Access denied: You are not assigned to this shop" }
      }
    },
    {
      "id": "employee-get-pending",
      "group": "Employee - Enquiries",
