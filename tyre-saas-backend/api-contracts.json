        "404": { "success": false, "message": "Enquiry not found" }
      }
    },
    {
      "id": "employee-update-enquiry",
      "group": "Employee - Enquiries",
      "method": "PATCH",
      "path": "/api/v1/employee/enquiries/:id",
      "auth": { "required": true, "roles": ["EMPLOYEE", "ADMIN"] },
      "rateLimiter": "apiLimiter",
      "description": "Update enquiry status, reschedule follow-up, change budget, or log remarks.",
      "pathParams": [{ "name": "id", "type": "string", "required": true, "example": "enq-9999-uuid" }],
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "fields": [
          { "name": "status", "type": "string", "required": false, "validation": "Enum: PENDING | WON | LOST | NO_RESPONSE | FOLLOW_UP", "example": "WON" },
          { "name": "lossReason", "type": "string", "required": false, "validation": "Required if status is LOST", "example": "Found lower price online" },
          { "name": "followUpDate", "type": "string", "required": false, "validation": "ISO 8601 string. Required if status is PENDING or FOLLOW_UP", "example": "2026-10-10T10:00:00.000Z" },
          { "name": "remarks", "type": "string", "required": false, "example": "Customer confirmed booking" },
          { "name": "amount", "type": "number", "required": false, "example": 29000 },
          { "name": "estimatedBudget", "type": "number", "required": false, "example": 29000 }
        ]
      },
      "responses": {
        "200": { "success": true, "data": { "id": "enq-9999-uuid", "status": "WON" } }
      }
    },
