    {
      "id": "auth-login",
      "group": "Authentication",
      "method": "POST",
      "path": "/api/v1/auth/login",
      "auth": { "required": false },
      "rateLimiter": "loginLimiter (5 failed attempts per phone locks for 15 minutes)",
      "description": "Authenticate user via phone and password.",
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "fields": [
          {
            "name": "phone",
            "type": "string",
            "required": true,
            "validation": "Non-empty string. Exactly 10 digits recommended.",
            "example": "9999999999"
          },
          {
            "name": "password",
            "type": "string",
            "required": true,
            "validation": "Non-empty string. Verified via bcrypt.",
            "example": "admin123"
          }
        ]
      },
      "responses": {
        "200": {
          "success": true,
          "data": {
            "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
            "user": {
              "id": "u-1234-uuid",
              "phone": "9999999999",
              "fullName": "Rajesh Mehta",
              "role": "ADMIN",
              "organizationId": "org-5678-uuid"
            }
          }
        },
        "400": { "success": false, "message": "Phone and password are required" },
        "401": { "success": false, "message": "Invalid credentials" },
        "403": { "success": false, "message": "Account or organization has been deactivated" },
        "429": { "success": false, "message": "Too many failed login attempts. Please try again later." }
      }
    },
    {
      "id": "auth-me",
      "group": "Authentication",
      "method": "GET",
      "path": "/api/v1/auth/me",
      "auth": { "required": true, "roles": ["ADMIN", "EMPLOYEE", "SUPER_ADMIN"], "header": "Authorization: Bearer <token>" },
      "rateLimiter": "apiLimiter",
      "description": "Fetch current authenticated user profile and tenant details.",
      "requestBody": null,
      "responses": {
        "200": {
          "success": true,
          "data": {
            "id": "u-1234-uuid",
            "phone": "9999999999",
            "fullName": "Rajesh Mehta",
            "role": "ADMIN",
            "organizationId": "org-5678-uuid"
          }
        }
      }
    },
    {
      "id": "auth-logout",
      "group": "Authentication",
      "method": "POST",
      "path": "/api/v1/auth/logout",
      "auth": { "required": true, "roles": ["ADMIN", "EMPLOYEE", "SUPER_ADMIN"], "header": "Authorization: Bearer <token>" },
      "rateLimiter": "apiLimiter",
      "description": "Invalidates JWT token by inserting jti into revoked_tokens table.",
      "requestBody": null,
      "responses": {
        "200": { "success": true, "message": "Logout successful" }
      }
    },
    {
      "id": "employee-get-shops",
